<?xml version="1.0"?>
<!--
  Fixture: export_transmission_actuators on a SimpleTransmission (joint1, reduction 2.0) and a
  DifferentialTransmission (joint2, joint3). See transmission_actuators_launch_test.py.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="transmission_actuators_robot">
  <xacro:arg name="headless" default="true"/>

  <xacro:macro name="slider" params="name y">
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.04 0.04 0.04"/>
        </geometry>
      </visual>
    </link>

    <joint name="${name}" type="prismatic">
      <parent link="world"/>
      <child link="${name}_link"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.5" upper="0.5" velocity="1.0" effort="100.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <link name="world"/>
  <xacro:slider name="joint1" y="-0.2"/>
  <xacro:slider name="joint2" y="0.0"/>
  <xacro:slider name="joint3" y="0.2"/>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">
        $(find mujoco_ros2_control_tests)/test_resources/scenes/transmission_actuators_scene.xml
      </param>
      <param name="sim_speed_factor">1.0</param>
      <param name="headless">$(arg headless)</param>
      <param name="export_transmission_actuators">true</param>
    </hardware>

    <xacro:position_joint name="joint1"/>
    <xacro:position_joint name="joint2"/>
    <xacro:position_joint name="joint3"/>

    <transmission name="simple_trans">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <joint name="joint1" role="joint1">
        <mechanical_reduction>2.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
      <actuator name="actuator1" role="actuator1"/>
    </transmission>

    <transmission name="differential_trans">
      <plugin>transmission_interface/DifferentialTransmission</plugin>
      <actuator name="actuator2" role="actuator1">
        <mechanical_reduction>1.0</mechanical_reduction>
      </actuator>
      <actuator name="actuator3" role="actuator2">
        <mechanical_reduction>1.0</mechanical_reduction>
      </actuator>
      <joint name="joint2" role="joint1">
        <mechanical_reduction>1.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
      <joint name="joint3" role="joint2">
        <mechanical_reduction>1.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
    </transmission>
  </ros2_control>
</robot>
