<mujoco model="read_only_actuator_robot">
  <compiler angle="radian"/>
  <!-- Gravity off: the bodies only move when commanded, so the test can assert exact positions. -->
  <option gravity="0 0 0" timestep="0.001"/>

  <worldbody>
    <body name="driven_link" pos="0 -0.1 0">
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
      <joint name="driven" type="slide" axis="1 0 0" range="-0.5 0.5" damping="1.0"/>
      <geom name="driven_geom" type="box" size="0.02 0.02 0.02" rgba="0.8 0.4 0.1 1"/>
    </body>
    <body name="reference_link" pos="0 0.1 0">
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
      <joint name="reference" type="slide" axis="1 0 0" range="-0.5 0.5" damping="1.0"/>
      <geom name="reference_geom" type="box" size="0.02 0.02 0.02" rgba="0.1 0.4 0.8 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Driven through relative_joint (effort). -->
    <motor name="driven" joint="driven" ctrlrange="-10 10"/>
    <!-- Driven through reference_joint (position); relative_trans only reads it. -->
    <position name="reference" joint="reference" kp="2000" dampratio="1" ctrlrange="-0.5 0.5"/>
  </actuator>
</mujoco>
