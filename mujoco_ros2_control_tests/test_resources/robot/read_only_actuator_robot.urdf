<?xml version="1.0"?>
<!--
  Fixture: relative_joint is measured relative to the 'reference' actuator, which its transmission only
  reads (read_only); 'reference' is commanded through reference_joint. See read_only_actuator_launch_test.py.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="read_only_actuator_robot">
  <xacro:arg name="headless" default="true"/>

  <link name="world"/>

  <link name="driven_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
    </visual>
  </link>

  <link name="reference_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
    </visual>
  </link>

  <joint name="relative_joint" type="prismatic">
    <parent link="world"/>
    <child link="driven_link"/>
    <origin xyz="0 -0.1 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" velocity="1.0" effort="10.0"/>
  </joint>

  <joint name="reference_joint" type="prismatic">
    <parent link="world"/>
    <child link="reference_link"/>
    <origin xyz="0 0.1 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" velocity="1.0" effort="100.0"/>
  </joint>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">
        $(find mujoco_ros2_control_tests)/test_resources/scenes/read_only_actuator_scene.xml
      </param>
      <param name="sim_speed_factor">1.0</param>
      <param name="headless">$(arg headless)</param>
    </hardware>

    <joint name="relative_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="reference_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <transmission name="relative_trans">
      <plugin>mujoco_ros2_control_tests/RelativeTransmission</plugin>
      <joint name="relative_joint" role="joint"/>
      <actuator name="driven" role="driven"/>
      <actuator name="reference" role="reference" read_only="true"/>
    </transmission>

    <transmission name="reference_trans">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <joint name="reference_joint" role="joint1">
        <mechanical_reduction>1.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
      <actuator name="reference" role="actuator1"/>
    </transmission>
  </ros2_control>
</robot>
